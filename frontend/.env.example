# Backend origin only — NO /api (e.g. https://your-backend.railway.app)
VITE_API_URL=https://your-backend.railway.app
# Optional: VITE_API_BASE_URL is an alias for VITE_API_URL
# Google OAuth client ID (Web application type)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
# Support email shown on /help page (default: support@mycareerconnects.in)
VITE_SUPPORT_EMAIL=support@mycareerconnects.in
