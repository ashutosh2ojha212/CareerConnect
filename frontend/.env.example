# Backend origin only — NO /api
# RECOMMENDED: use a custom domain you control (e.g. https://api.mycareerconnects.in)
# Avoid using Railway-generated subdomains (*.up.railway.app) — they can cause
# DNS_PROBE_FINISHED_NXDOMAIN for some users due to unreliable DNS propagation.
VITE_API_URL=https://api.mycareerconnects.in
# Optional: VITE_API_BASE_URL is an alias for VITE_API_URL
# Google OAuth client ID (Web application type)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
# Support email shown on /help page (default: support@mycareerconnects.in)
VITE_SUPPORT_EMAIL=support@mycareerconnects.in
