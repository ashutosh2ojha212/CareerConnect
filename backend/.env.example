# PostgreSQL (required for production). Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# For local dev with Docker: postgresql://postgres:postgres@localhost:5432/careerconnect
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# In production use a strong secret (min 32 chars); never commit real values
JWT_SECRET="carrier-connect-super-secret-jwt-key-change-in-production-2024"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# CORS: use exact Vercel domain — "career" not "carrer"
FRONTEND_URL=http://localhost:5173
# Production example: https://career-connect-frontend.vercel.app

# Admin: set this to promote a user to admin (run: npx ts-node src/scripts/promote-admin.ts)
# ADMIN_EMAIL=mycareerconnects@gmail.com

# Email Configuration (for password reset, OTP, notifications)
# Resend (recommended on Railway — no SMTP ports needed): https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
# Fallback: Gmail SMTP (use App Password: https://support.google.com/accounts/answer/185833)
SMTP_USER=mycareerconnects@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=CareerConnect <noreply@mycareerconnects.in>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
